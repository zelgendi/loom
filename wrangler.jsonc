{
  // Configurazione Cloudflare Workers del sito LOOM: file statici dalla radice del repository,
  // worker/index.js gestisce solo /api/auth (login del pannello).
  "name": "loom",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
