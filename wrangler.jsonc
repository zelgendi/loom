{
  // Configurazione Cloudflare Workers del sito LOOM: file statici dalla radice del repository,
  // worker/index.js gestisce /api/auth (login del pannello) e /api/contatto (moduli).
  // EMAIL: Cloudflare Email Service, può scrivere solo all'indirizzo verificato indicato qui.
  "name": "loom",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "send_email": [{ "name": "EMAIL", "destination_address": "z.elgendi@gmail.com" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
